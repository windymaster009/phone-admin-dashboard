<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- MainActivity rejects public HTTP hosts. Cleartext remains available only
         so a development phone can reach a private LAN or emulator backend. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
