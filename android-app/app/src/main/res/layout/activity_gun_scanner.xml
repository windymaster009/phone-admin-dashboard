<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/gunCameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#E608101F"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gun_scanner_title"
            android:textColor="@color/phoneflow_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/gun_scanner_hint"
            android:textColor="@color/phoneflow_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="280dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:background="@drawable/scanner_frame" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E608101F"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/gunScannerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/gun_scanner_ready"
            android:textColor="@color/phoneflow_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancelGunScanButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@color/phoneflow_surface_alt"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/phoneflow_text" />

            <Button
                android:id="@+id/torchButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/phoneflow_surface_alt"
                android:text="@string/torch"
                android:textAllCaps="false"
                android:textColor="@color/phoneflow_text" />
        </LinearLayout>

        <Button
            android:id="@+id/gunScanButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/phoneflow_primary"
            android:text="@string/gun_scanner_trigger"
            android:textAllCaps="false"
            android:textColor="@color/phoneflow_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
