# Use a dedicated database name for this project. Do not commit real credentials.
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/phone_shop?retryWrites=true&w=majority&appName=PhoneFlow
JWT_SECRET=GENERATE_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=12h
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Android no longer receives an automatic LAN owner session. Pairing codes are
# generated from Security by an already authenticated staff member, can be used
# once, and expire after this many seconds (30-300 allowed).
ANDROID_PAIRING_TTL_SECONDS=90
# Leave false when Node is directly reachable. If production traffic always
# passes through one trusted reverse proxy, set this to 1.
TRUST_PROXY=false
# Production owner setup requires this one-time secret when the user table is empty.
AUTH_BOOTSTRAP_TOKEN=GENERATE_A_RANDOM_ONE_TIME_SETUP_SECRET

# Remote Atlas clusters can briefly pause or reconnect. Keep operation timeouts
# long enough that an acknowledged write is not reported to the UI as a 500.
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_SOCKET_TIMEOUT_MS=60000
MONGO_MAX_POOL_SIZE=10

# Daily compressed backups contain every MongoDB collection and uploaded image.
# Keep BACKUP_DIR on persistent storage that is not publicly served by Express.
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_SCHEDULE=02:00
BACKUP_TIMEZONE=Asia/Phnom_Penh
BACKUP_RETENTION_COUNT=14
BACKUP_RETRY_MINUTES=60

# Secure customer documents are encrypted with AES-256-GCM before MongoDB
# storage. Generate this key once, store it separately from backups, and never
# rotate it without first migrating existing documents:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_MAX_BYTES=5242880

# Printed receipt and invoice identity. Values are copied into an immutable
# snapshot when a receipt is first generated.
SHOP_NAME=PhoneFlow
SHOP_SUBTITLE=Phone Shop Management
SHOP_PHONE=
SHOP_EMAIL=
SHOP_ADDRESS=
SHOP_TAX_ID=
SHOP_LOGO_URL=
SHOP_RECEIPT_FOOTER=Thank you for your business.

# ABA PayWay is server-only. Never prefix these names with VITE_ and never put
# the API key in frontend code. Start disabled until ABA sends sandbox
# credentials and whitelists the backend IP/domain.
PAYWAY_ENABLED=false
PAYWAY_ENV=sandbox
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=YOUR_ABA_PAYWAY_MERCHANT_ID
PAYWAY_API_KEY=YOUR_ABA_PAYWAY_API_KEY
PAYWAY_CALLBACK_URL=
PAYWAY_REQUEST_TIMEOUT_MS=10000

# KHQR only, using ABA's QR image template 3.
PAYWAY_QR_TEMPLATE=template3_color
PAYWAY_QR_LIFETIME_MINUTES=6

# Select the ABA USD/KHR side required by the shop's conversion policy.
# Confirm buy vs sell with ABA before production.
PAYWAY_USD_KHR_RATE_SIDE=buy
USD_KHR_FALLBACK_RATE=4100
